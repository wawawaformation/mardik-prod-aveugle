        <mxCell id="sstitre" value="Objectif de lecture : montrer ce que la supervision classique ne voit pas, et ce qu'une trace restitue." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
