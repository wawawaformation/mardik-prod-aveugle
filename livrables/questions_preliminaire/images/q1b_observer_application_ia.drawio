        <mxCell id="m5" value="contexte tronqué en amont  →  &lt;b&gt;ÉCHEC&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#B85450;" vertex="1" parent="1">
