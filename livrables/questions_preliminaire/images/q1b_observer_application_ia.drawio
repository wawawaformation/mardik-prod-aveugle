        <mxCell id="titre" value="&lt;b&gt;Q1b — Ce que veut dire observer une application IA&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#333333;" vertex="1" parent="1">
