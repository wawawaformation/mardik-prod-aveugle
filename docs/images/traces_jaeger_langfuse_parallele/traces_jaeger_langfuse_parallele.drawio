<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="traces-jaeger-langfuse" name="Traces en parallèle — Jaeger / Langfuse">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titre" value="&lt;b&gt;Export des traces en parallèle — Jaeger et Langfuse&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sstitre" value="Objectif de lecture : le même span part vers deux backends indépendants — un échec sur l'un n'affecte pas l'autre." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="42" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;Agent Mardik&lt;/b&gt;&lt;br&gt;spans agent.turn / llm.invoke / tool.call&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999999&quot;&gt;&lt;i&gt;agent.py&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="85" width="340" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sdk" value="&lt;b&gt;OpenTelemetry SDK — TracerProvider&lt;/b&gt;&lt;br&gt;2 SpanProcessor (un par exportateur)&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999999&quot;&gt;&lt;i&gt;telemetry.py — build_telemetry()&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="185" width="380" height="65" as="geometry" />
        </mxCell>

        <!-- Branche gauche : Jaeger -->
        <mxCell id="proc-jaeger" value="SimpleSpanProcessor #1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="300" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exp-jaeger" value="&lt;b&gt;OTLPSpanExporter (gRPC)&lt;/b&gt;&lt;br&gt;endpoint :4317 · sans authentification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="370" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="jaeger" value="&lt;b&gt;Jaeger all-in-one&lt;/b&gt;&lt;br&gt;collecteur OTLP (:4317) + UI de traces (:16686)&lt;br&gt;généraliste, pas de notion de prompt/coût" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- Branche droite : Langfuse -->
        <mxCell id="proc-langfuse" value="SimpleSpanProcessor #2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="300" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exp-langfuse" value="&lt;b&gt;OTLPSpanExporter (HTTP)&lt;/b&gt;&lt;br&gt;POST /api/public/otel/v1/traces&lt;br&gt;Basic Auth (public_key:secret_key en base64)&lt;br&gt;gRPC non supporté par Langfuse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="370" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="langfuse" value="&lt;b&gt;Langfuse (self-hébergé)&lt;/b&gt;&lt;br&gt;langfuse-web :3000 — ingestion + UI&lt;br&gt;spécifique LLM : prompts, tokens, coûts, sessions, scores" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="465" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Activation conditionnelle&lt;/b&gt; — la branche Langfuse n'existe que si LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY sont renseignées (.env). Sans elles, seul Jaeger reçoit les traces : comportement identique à avant, tests et CI non affectés." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="580" width="1010" height="50" as="geometry" />
        </mxCell>

        <!-- Flèches -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="agent" target="sdk"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sdk" target="proc-jaeger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="proc-jaeger" target="exp-jaeger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exp-jaeger" target="jaeger"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sdk" target="proc-langfuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="proc-langfuse" target="exp-langfuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exp-langfuse" target="langfuse"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legende" value="&lt;b&gt;Légende&lt;/b&gt;   bleu = code Mardik   ·   gris = SDK OTel   ·   orange = exportateur (protocole)   ·   violet = backend d'observabilité" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="650" width="1010" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
