<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="pipeline-observabilite-mardik" name="Pipeline Mardik — spans et signaux">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titre" value="&lt;b&gt;Pipeline Mardik — spans, métriques, logs (état réel)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sstitre" value="Objectif de lecture : suivre la hiérarchie des spans d'un tour d'agent jusqu'à leur backend, et voir quels signaux sont réellement centralisés." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="client" value="Session rejouée / requête utilisateur" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="85" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="spans-group" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;fontSize=12;fontColor=#6C8EBF;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="1000" height="280" as="geometry" />
        </mxCell>
        <mxCell id="spans-label" value="&lt;b&gt;Agent Mardik — hiérarchie des spans (agent.py)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="75" y="170" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="span-turn" value="&lt;b&gt;SPAN racine : agent.turn&lt;/b&gt;&lt;br&gt;thread principal&lt;br&gt;&lt;i&gt;aucun attribut personnalisé&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="205" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="span-llm" value="&lt;b&gt;SPAN enfant : llm.invoke&lt;/b&gt;&lt;br&gt;thread worker (contexte OTel&lt;br&gt;propagé explicitement)&lt;br&gt;&lt;i&gt;aucun attribut personnalisé&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="205" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="span-tool" value="&lt;b&gt;SPAN enfant : tool.call&lt;/b&gt;&lt;br&gt;thread principal, si&lt;br&gt;reply.tool_calls non vide&lt;br&gt;&lt;i&gt;aucun attribut personnalisé&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="205" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note-attrs" value="Enrichissement possible (non fait) : session_id, nom/modèle LLM, tokens sur llm.invoke ; nom d'outil et arguments sur tool.call." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="310" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="metric-latency" value="Métrique : latency_ms (histogramme)&lt;br&gt;attribut session_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="365" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="metric-errors" value="Métrique : errors_total (compteur)&lt;br&gt;attributs session_id, error.type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="365" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="log-events" value="Logs structurés (structlog JSON) :&lt;br&gt;turn.completed / turn.failed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="365" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="sdk" value="&lt;b&gt;OpenTelemetry SDK (telemetry.py)&lt;/b&gt;&lt;br&gt;TracerProvider + MeterProvider + structlog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;fontSize=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="jaeger" value="&lt;b&gt;Jaeger all-in-one&lt;/b&gt;&lt;br&gt;collecteur OTLP/gRPC (:4317)&lt;br&gt;+ UI de traces (:16686)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="console-metrics" value="&lt;b&gt;ConsoleMetricExporter&lt;/b&gt;&lt;br&gt;stdout uniquement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="console-logs" value="&lt;b&gt;JSONRenderer (structlog)&lt;/b&gt;&lt;br&gt;stdout uniquement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="590" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note-central" value="&lt;b&gt;⚠ Seules les traces sont centralisées.&lt;/b&gt; Métriques et logs restent en sortie standard du processus — pas de Prometheus, Loki ni Grafana câblés (contrairement au pipeline RAG de l'article de Sofiane, livrables/article_reel/). Cohérent avec le README : « l'observabilité est câblée mais n'a pas encore été validée de bout en bout sous charge »." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="690" width="900" height="55" as="geometry" />
        </mxCell>

        <mxCell id="legende" value="&lt;b&gt;Légende&lt;/b&gt;   bleu = span de trace   ·   orange = instrument de métrique / événement de log   ·   violet = backend centralisé   ·   rouge = sortie locale non centralisée" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="760" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Flèches -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="client" target="span-turn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="thread" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="span-turn" target="span-llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="join" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="span-llm" target="span-tool"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="span-turn" target="metric-latency"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="span-llm" target="metric-errors"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="span-tool" target="log-events"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="metric-latency" target="sdk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="metric-errors" target="sdk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="log-events" target="sdk"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e10" value="OTLP/gRPC" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sdk" target="jaeger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="périodique" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sdk" target="console-metrics"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="par appel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;dashed=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sdk" target="console-logs"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
