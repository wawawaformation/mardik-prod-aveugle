<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="langfuse-composants" name="Langfuse — composants et dépendances">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titre" value="&lt;b&gt;Langfuse self-hébergé — composants et dépendances (docker-compose.yml)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sstitre" value="Objectif de lecture : pourquoi chaque conteneur existe, et qui parle à qui. «execution environment» = conteneur, «node» = service géré par ce conteneur." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="42" width="1200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="mardik" value="&lt;b&gt;Mardik&lt;/b&gt;&lt;br&gt;OTLPSpanExporter (HTTP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="web" value="«execution environment»&lt;br&gt;&lt;b&gt;langfuse-web&lt;/b&gt;&lt;br&gt;image langfuse/langfuse:4 · port 3000&lt;br&gt;ingestion OTLP + UI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="270" height="75" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="«node»&lt;br&gt;&lt;b&gt;redis&lt;/b&gt;&lt;br&gt;image redis:7&lt;br&gt;file d'attente (BullMQ) entre web et worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="90" width="270" height="75" as="geometry" />
        </mxCell>

        <mxCell id="worker" value="«execution environment»&lt;br&gt;&lt;b&gt;langfuse-worker&lt;/b&gt;&lt;br&gt;image langfuse/langfuse-worker:4&lt;br&gt;traitement asynchrone de l'ingestion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1450" y="90" width="270" height="75" as="geometry" />
        </mxCell>

        <mxCell id="postgres" value="«node»&lt;br&gt;&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;image postgres:17&lt;br&gt;métadonnées : projets, utilisateurs, clés API, auth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="340" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="clickhouse" value="«node»&lt;br&gt;&lt;b&gt;clickhouse&lt;/b&gt;&lt;br&gt;image clickhouse-server:25&lt;br&gt;stockage analytique (OLAP) des traces/observations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="340" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="minio" value="«node»&lt;br&gt;&lt;b&gt;minio&lt;/b&gt;&lt;br&gt;S3 compatible&lt;br&gt;gros payloads : médias, exports batch, événements" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1450" y="340" width="270" height="80" as="geometry" />
        </mxCell>

        <!-- Flèches -->
        <mxCell id="e1" value="OTLP/HTTP&#10;+ Basic Auth" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mardik" target="web"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e2" value="enqueue&#10;ingestion" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="dequeue" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="redis" target="worker"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e4" value="auth, projets,&#10;clés API" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="web" target="postgres"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e5" value="lecture&#10;(affichage UI)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="web" target="clickhouse"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" value="écriture&#10;traces/observations" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="worker" target="clickhouse"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e7" value="médias,&#10;exports (S3)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="worker" target="minio"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="&lt;b&gt;Pourquoi Redis ?&lt;/b&gt; L'ingestion OTLP doit répondre vite à Mardik : langfuse-web ne fait qu'empiler le lot reçu dans Redis (file BullMQ) et répond aussitôt. C'est langfuse-worker, en tâche de fond, qui traite réellement les événements et les écrit dans ClickHouse — sans Redis, l'ingestion bloquerait le web sur l'écriture analytique." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="460" width="1270" height="60" as="geometry" />
        </mxCell>

        <mxCell id="legende" value="&lt;b&gt;Légende&lt;/b&gt;   bleu = Mardik   ·   orange = processus Langfuse (conteneur applicatif)   ·   rouge = dépendance d'infrastructure (état/stockage)   ·   trait plein = communication réelle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1680" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
